DATABASE_URL=
SESSION_SECRET=
BLOB_READ_WRITE_TOKEN=

# SMS via msegat.com — password reset codes and the welcome message.
# Without all three, sending is skipped: the reset form says the service is
# unavailable, and approving a registration still works but sends no greeting.
MSEGAT_USERNAME=
MSEGAT_API_KEY=
MSEGAT_SENDER=
# Optional; defaults to https://www.msegat.com
MSEGAT_BASE_URL=

# Absolute site URL for Open Graph tags and the sitemap.
# Falls back to the Vercel production host, then localhost.
NEXT_PUBLIC_SITE_URL=
